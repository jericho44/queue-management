# Application Environment
APP_ENV=development
APP_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=queue_management
DB_SSLMODE=disable

# Redis Configuration
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# JWT Authentication Secret
JWT_SECRET=super-secret-production-jwt-token-key-32chars

# CORS Configuration
CORS_ORIGINS=*

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-DummyKeyForDevelopment
MIDTRANS_CLIENT_KEY=SB-Mid-client-DummyKeyForDevelopment
MIDTRANS_IS_SANDBOX=true
